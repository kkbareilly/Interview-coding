A professor in the Computer Science department of HackerLand College wants to generate an array. Given an array of integers of length and two integers/ and find another array, br, such that:

l<=brr[i]<=r
brr[i] - arr[i] < brr[i+1] - arr[i+1]
brr[i] <= brr[i+1]
Among all such arrays, return the lexicographically smallest one if there in not an array that satisfies the conditions then return an array with the single element -1.

vector<int> getSmallestArray(vector<int> arr, int l, int r){
    int lastDiff = INT_MIN, currDiff = 0;
    res[0] = l;
    for(int i=0;i<arr.size();i++){
        lastDiff = res[i-1] - arr[i-1];
        currDiff = lastDiff+1;
        int curr = currDiff + arr[i];
        curr = max(curr, res[i-1]);
        res[i] = curr;
        if(curr>r)  return {-1};
    }
    return res;
}
